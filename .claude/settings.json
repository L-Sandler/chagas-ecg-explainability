{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(runpodctl pod create *)",
      "Bash(runpodctl pod delete *)",
      "Bash(runpodctl remove pod *)",
      "Bash(runpodctl pod get *)",
      "Bash(runpodctl pod list*)",
      "Bash(runpodctl gpu list*)",
      "Bash(ssh *root@*)",
      "Bash(scp *)"
    ],
    "deny": [
      "Edit(/.guardrails/**)",
      "Edit(/.claude/**)",
      "Edit(/spec/runs/**)",
      "Edit(/scripts/launch_run.py)",
      "Edit(/scripts/sweep_driver.sh)",
      "Edit(/CLAUDE.md)",
      "Edit(/README.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "ssh *",
      "scp *",
      "runpodctl *",
      "./scripts/create_pod.sh *",
      "git push *",
      "git pull *",
      "git fetch *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.local/share/uv"
      ],
      "denyWrite": [
        "./.guardrails",
        "./.claude",
        "./spec/runs",
        "./notes/decisions",
        "./scripts/launch_run.py",
        "./scripts/sweep_driver.sh",
        "./CLAUDE.md",
        "./README.md",
        "./src/preprocess.py",
        "./src/dataset.py",
        "./src/model.py",
        "./src/train.py",
        "./src/explain.py"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "download.pytorch.org",
        "api.wandb.ai",
        "github.com",
        "zenodo.org",
        "physionet.org"
      ]
    }
  }
}
